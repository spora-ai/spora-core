includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-mockery/extension.neon

parameters:
    paths:
        - app
        - tests
        - database/migrations
    level: 5
    excludePaths:
        - vendor
        - tests/Fixtures
    bootstrapFiles:
        - phpstan-bootstrap.php
    ignoreErrors:
        # Pest dynamic __call methods (afterEach, beforeEach, etc. on TestCall via __call)
        - '#Call to an undefined method Pest\\PendingCalls\\TestCall::#'
        # Pest dynamic property access on TestCall (e.g. $userId, $agentId set by test)
        - '#Access to an undefined property Pest\\PendingCalls\\TestCall::#'
        # `test()->fail(...)` lives on Pest\TestCall via __call (see above).
        - '#Call to an undefined method Pest\\.*::fail\(\)#'
        # Capsule Manager __callStatic forwarding (migrations) — select / selectOne /
        # statement / insert / transaction are dispatched through __callStatic to
        # static::connection()->$method(...), which PHPStan cannot trace.
        - '#Call to an undefined static method Illuminate\\Database\\Capsule\\Manager::#'
