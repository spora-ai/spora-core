###############################################################################
# Spora .gitignore
###############################################################################

# ── Secrets & user-generated config ─────────────────────────────────────────
# config.php is the operator's own file and may contain the DB password.
# It must never be committed. Nothing generates it — the operator writes it,
# or uses .env instead.
#
# Anchored to the repository root: unanchored, this also matched
# app/Core/Config.php (the Config value object) on a case-insensitive
# filesystem, so `git add` on it was a silent no-op.
/config.php

# Dotenv (used by Docker / VPS users instead of config.php)
.env
.env.*
!.env.example
!.env.local.example

# ── Encryption key ───────────────────────────────────────────────────────────
# The key is deliberately stored outside the project by install.php.
# If it ends up inside storage/ as a last resort, make sure it stays out of git.
storage/secret.key

# ── Database ─────────────────────────────────────────────────────────────────
storage/database.sqlite
storage/database-backup.sqlite
storage/database.sqlite-shm
storage/database.sqlite-wal
storage/database.sqlite-journal

# Schema installer stamp — regenerated on every migration run, not source
storage/.schema_stamp

# Plugin loader stamp + sidecar — regenerated on every plugin boot, not source
storage/.plugins_stamp
storage/.plugins_stamp.cache.json

# Plugin catalog HTTP cache. Written into `Paths::storage()`, and the full suite
# leaks one into the repo's own storage/ — a test in a run other than
# PluginsCatalogControllerTest, which correctly uses a temp root.
storage/.spora_plugin_catalog.json

# Keep the empty storage/ directory in the repo
!storage/.gitkeep

# Runtime asset payloads — written by DerivativePayloadStoreTest and the
# ingest pipeline, never source
storage/assets/

# ── Logs ─────────────────────────────────────────────────────────────────────
storage/*.log
*.log

# ── Locks ─────────────────────────────────────────────────────────────────────
storage/*.lock

# ── Composer ─────────────────────────────────────────────────────────────────
/vendor/

# ── Docker ───────────────────────────────────────────────────────────────────
# Runtime env (contains secrets) and persistent storage
docker/.env.local
docker/storage/

# ── Frontend (Vue / Vite) ────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
# Vitest coverage output (lcov.info + HTML report); produced by `npm run test:coverage`
frontend/coverage/

# Vite build output (produced by `make dev` / `composer frontend:build`)
public/dist/

# ── PHP tooling ──────────────────────────────────────────────────────────────
.php-cs-fixer.cache
.phpunit.cache/

# ── Claude Code ───────────────────────────────────────────────────────────────
.claude/

# ─VS Code ───────────────────────────────────────────────────────────────────
.vscode/

# Codex
.codex/

# ── OS artefacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor / IDE ─────────────────────────────────────────────────────────────
.idea/
*.swp
*.swo

# ── Misc artefacts ───────────────────────────────────────────────────────────
# Leftover SQLite in-memory filename that can appear at the project root
:memory:

/coverage
/coverage.xml
/node_modules

# Local Codex agent artifacts (plans, scratch notes) — not for the project repo
.agents/plans/

# Ignore plugins
/plugins/*
!/plugins/.gitkeep

/.worktrees/
spora-core-worktrees/

/tmp/
