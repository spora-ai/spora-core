###############################################################################
# Spora .gitignore
###############################################################################

# ── Secrets & user-generated config ─────────────────────────────────────────
# config.php is the operator's own file and may contain the DB password.
# It must never be committed. Nothing generates it — the operator writes it,
# or uses .env instead.
#
# Anchored to the repository root: unanchored, this also matched
# app/Core/Config.php (the Config value object) on a case-insensitive
# filesystem, so `git add` on it was a silent no-op.
/config.php

# Dotenv (used by Docker / VPS users instead of config.php)
.env
.env.*
!.env.example
!.env.local.example

# ── Runtime state ────────────────────────────────────────────────────────────
# Everything under storage/ is runtime state, never source: the database,
# the secret key, the schema and plugin stamps, the plugin catalog cache,
# the asset payloads, the logs, and the worker lock with its takeover
# mutex.
#
# The blanket rule is deliberate. The framework's own test suite writes
# into the repo's storage/, and a worker run here leaves
# `spora-worker.lock` and `spora-worker.lock.takeover` behind. Listing
# the files one by one meant every new runtime file had to be added here
# too, and the takeover mutex was missed — the one rule that had to
# cover a file that does not end in `.lock`.
#
# The skeleton (the operator-facing app) tracks an empty storage/.gitkeep;
# the rule keeps that placeholder addable here too.
storage/*
!storage/.gitkeep

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ── Composer ─────────────────────────────────────────────────────────────────
/vendor/

# ── Docker ───────────────────────────────────────────────────────────────────
# Runtime env (contains secrets) and persistent storage
docker/.env.local
docker/storage/

# ── Frontend (Vue / Vite) ────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
# Vitest coverage output (lcov.info + HTML report); produced by `npm run test:coverage`
frontend/coverage/

# Vite build output (produced by `make dev` / `composer frontend:build`)
public/dist/

# ── PHP tooling ──────────────────────────────────────────────────────────────
.php-cs-fixer.cache
.phpunit.cache/

# ── Claude Code ───────────────────────────────────────────────────────────────
.claude/

# ─VS Code ───────────────────────────────────────────────────────────────────
.vscode/

# Codex
.codex/

# ── OS artefacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor / IDE ─────────────────────────────────────────────────────────────
.idea/
*.swp
*.swo

# ── Misc artefacts ───────────────────────────────────────────────────────────
# Leftover SQLite in-memory filename that can appear at the project root
:memory:

/coverage
/coverage.xml
/node_modules

# Local Codex agent artifacts (plans, scratch notes) — not for the project repo
.agents/plans/

# Ignore plugins
/plugins/*
!/plugins/.gitkeep

/.worktrees/
spora-core-worktrees/
/.wt/

/tmp/
